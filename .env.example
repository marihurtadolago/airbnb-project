# Copy this file to .env and fill in your own values.
# The .env file is ignored by git and must never be committed.

# Connection string of the Azure Storage Account
# (Azure portal > Storage account > Security + networking > Access keys).
# If it is empty, the pipeline runs locally and skips the Azure upload with a warning.
AZURE_STORAGE_CONNECTION_STRING=

# Incoming webhook of the team chat channel (Discord, Slack or Teams) for alerts.
# If it is empty, alerts are only written to the log.
ALERT_WEBHOOK_URL=
